{
  "schema_version": "0.2.0",
  "registry_name": "retail",
  "registry_version": "0.4.0",
  "compatibility": "custom_tau_style_not_literal_tau_registry",
  "design_note": "Models a single-brand retail customer-care desk: verified customer/order reads, delivered-not-received and missing-refund traces, replacement creation, case notes, and case notifications over a small closed entity graph. Result schemas are fully typed and closed (additionalProperties: false at every level) so a deterministic tau2-bench-style mock environment can be implemented from this registry alone. Status and resolution vocabularies are enumerated as the union of the policy lifecycles and the recorded tool outputs.",
  "tools": [
    {
      "name": "lookup_customer",
      "description": "Find a retail customer and recent orders using a verified email or customer identifier.",
      "parameters": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email on the order.",
            "format": "email"
          },
          "customer_id": {
            "type": "string",
            "description": "Optional customer identifier.",
            "format": "uuid"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "customer_id": {
            "type": "string",
            "description": "Customer identifier.",
            "format": "uuid"
          },
          "match": {
            "type": "string",
            "description": "Lookup outcome.",
            "enum": [
              "unique",
              "multiple",
              "none"
            ]
          },
          "display_name": {
            "type": "string",
            "description": "Customer display name."
          },
          "recent_orders": {
            "type": "array",
            "description": "Recent orders for the matched customer.",
            "items": {
              "type": "object",
              "properties": {
                "order_reference": {
                  "type": "string",
                  "description": "Order reference."
                },
                "item": {
                  "type": "string",
                  "description": "Representative item description."
                },
                "open_case_id": {
                  "type": "string",
                  "description": "Open support case attached to the order, when one exists.",
                  "format": "uuid"
                },
                "open_case_number": {
                  "type": "string",
                  "description": "Customer-facing number for the open support case."
                }
              },
              "required": [
                "order_reference"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "customer_id",
          "match"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_order",
      "description": "Retrieve an order with items, fulfillment, carrier scans, payments, refunds, cases, and eligible resolutions.",
      "parameters": {
        "type": "object",
        "properties": {
          "order_reference": {
            "type": "string",
            "description": "Full order reference or its last 4 digits; a partial value is resolved by longest-suffix match against the customer's orders."
          },
          "customer_email": {
            "type": "string",
            "description": "Email on the order.",
            "format": "email"
          },
          "include": {
            "type": "array",
            "description": "Order sections to retrieve.",
            "items": {
              "type": "string",
              "description": "Order section.",
              "enum": [
                "items",
                "fulfillment",
                "carrier_scans",
                "payments",
                "refunds",
                "cases",
                "eligible_resolutions",
                "notifications"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "order_reference",
          "customer_email"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "order_reference": {
            "type": "string",
            "description": "Order reference as resolved by the source system."
          },
          "customer": {
            "type": "object",
            "description": "Customer associated with the order.",
            "properties": {
              "customer_id": {
                "type": "string",
                "description": "Customer identifier.",
                "format": "uuid"
              },
              "display_name": {
                "type": "string",
                "description": "Customer display name."
              },
              "verified_email": {
                "type": "string",
                "description": "Masked verified email on the order."
              }
            },
            "required": [
              "display_name",
              "verified_email"
            ],
            "additionalProperties": false
          },
          "items": {
            "type": "array",
            "description": "Order items.",
            "items": {
              "type": "object",
              "properties": {
                "item_reference": {
                  "type": "string",
                  "description": "Order-item reference."
                },
                "product_reference": {
                  "type": "string",
                  "description": "Product reference for the item."
                },
                "name": {
                  "type": "string",
                  "description": "Item name."
                },
                "variant": {
                  "type": "string",
                  "description": "Variant label."
                },
                "color": {
                  "type": "string",
                  "description": "Variant color."
                },
                "total_after_tax": {
                  "type": "number",
                  "description": "Item total after tax.",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "description": "Currency of monetary amounts on this item.",
                  "enum": [
                    "USD"
                  ]
                }
              },
              "required": [
                "item_reference"
              ],
              "additionalProperties": false
            }
          },
          "fulfillment": {
            "type": "object",
            "description": "Fulfillment state and carrier evidence.",
            "properties": {
              "status": {
                "type": "string",
                "description": "Fulfillment lifecycle state.",
                "enum": [
                  "placed",
                  "processing",
                  "fulfilled",
                  "shipped",
                  "out_for_delivery",
                  "delivered"
                ]
              },
              "latest_scan": {
                "type": "object",
                "description": "Most recent carrier scan.",
                "properties": {
                  "time": {
                    "type": "string",
                    "description": "Human-readable local scan time relative to the call (not ISO)."
                  },
                  "location": {
                    "type": "string",
                    "description": "Scan location description."
                  },
                  "photo": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Delivery photo reference; null when no photo exists."
                  }
                },
                "required": [
                  "time",
                  "location"
                ],
                "additionalProperties": false
              },
              "carrier_evidence": {
                "type": "object",
                "description": "Detailed carrier evidence for the delivery.",
                "properties": {
                  "scan_location": {
                    "type": "string",
                    "description": "Where the carrier recorded the scan."
                  },
                  "unit_number": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Unit number in the scan; null when unavailable."
                  },
                  "locker": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Locker reference; null when unavailable."
                  },
                  "photo": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Delivery photo reference; null when no photo exists."
                  },
                  "possible_misscan": {
                    "type": "boolean",
                    "description": "Whether the evidence is consistent with a mis-scan."
                  }
                },
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "payments": {
            "type": "array",
            "description": "Payment tenders on the order.",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Tender type.",
                  "enum": [
                    "gift_card",
                    "debit",
                    "credit",
                    "store_credit"
                  ]
                },
                "amount": {
                  "type": "number",
                  "description": "Tender amount.",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "description": "Currency of monetary amounts on this tender.",
                  "enum": [
                    "USD"
                  ]
                },
                "original_card_last4": {
                  "type": "string",
                  "description": "Last 4 digits of the original card.",
                  "pattern": "^[0-9]{4}$"
                }
              },
              "required": [
                "type",
                "amount"
              ],
              "additionalProperties": false
            }
          },
          "refunds": {
            "type": "array",
            "description": "Return and refund records; a record carries either return acceptance fields or per-tender refund fields.",
            "items": {
              "type": "object",
              "properties": {
                "return_reference": {
                  "type": "string",
                  "description": "Return reference."
                },
                "return_status": {
                  "type": "string",
                  "description": "Return processing state, e.g. complete."
                },
                "accepted_at": {
                  "type": "string",
                  "description": "Location where the return was accepted."
                },
                "accepted_age_days": {
                  "type": "integer",
                  "description": "Days since the return was accepted.",
                  "minimum": 0
                },
                "inventory_disposition": {
                  "type": "string",
                  "description": "Inventory outcome for the returned item, e.g. restocked."
                },
                "tender_type": {
                  "type": "string",
                  "description": "Tender the refund applies to.",
                  "enum": [
                    "gift_card",
                    "debit",
                    "credit",
                    "store_credit"
                  ]
                },
                "amount": {
                  "type": "number",
                  "description": "Refund amount for this tender.",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "description": "Currency of monetary amounts on this record.",
                  "enum": [
                    "USD"
                  ]
                },
                "available_balance": {
                  "type": "number",
                  "description": "Currently available balance for a gift-card or store-credit refund.",
                  "minimum": 0
                },
                "status": {
                  "type": "string",
                  "description": "Westline-side refund tender state, e.g. issued_available, submitted_no_settlement_confirmation, active."
                },
                "used": {
                  "type": "boolean",
                  "description": "Whether the refunded balance has been spent."
                },
                "delivery": {
                  "type": "string",
                  "description": "How the refunded tender was delivered, e.g. digital_gift_card_number_in_email."
                },
                "original_card_last4": {
                  "type": "string",
                  "description": "Last 4 digits of the original card.",
                  "pattern": "^[0-9]{4}$"
                },
                "initiation_source": {
                  "type": "string",
                  "description": "Where the refund was initiated, e.g. store_register."
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "cases": {
            "type": "array",
            "description": "Support cases related to the order.",
            "items": {
              "type": "object",
              "properties": {
                "case_id": {
                  "type": "string",
                  "description": "Support case identifier.",
                  "format": "uuid"
                },
                "order_reference": {
                  "type": "string",
                  "description": "Order the case is scoped to."
                },
                "type": {
                  "type": "string",
                  "description": "Case type.",
                  "enum": [
                    "delivery_trace",
                    "refund_trace"
                  ]
                },
                "status": {
                  "type": "string",
                  "description": "Support-case lifecycle state.",
                  "enum": [
                    "open",
                    "pending_customer_or_external_response",
                    "resolution_eligible_or_ineligible",
                    "resolved",
                    "closed"
                  ]
                },
                "item": {
                  "type": "string",
                  "description": "Affected item description."
                },
                "preferences": {
                  "type": "object",
                  "description": "Case-scoped customer preferences.",
                  "properties": {
                    "pickup": {
                      "type": "string",
                      "description": "Preferred pickup location."
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "carrier_response": {
                  "type": "string",
                  "description": "Carrier response received so far, e.g. none."
                },
                "deadline": {
                  "type": "string",
                  "description": "Human-readable response deadline relative to the call (not ISO)."
                },
                "carrier_may_contact_customer": {
                  "type": "boolean",
                  "description": "Whether the carrier may contact the customer directly."
                },
                "replacement_created": {
                  "type": "boolean",
                  "description": "Whether a replacement order exists for this case."
                },
                "case_number": {
                  "type": "string",
                  "description": "Customer-facing support-case number; distinct from the internal case UUID."
                }
              },
              "required": [
                "case_id",
                "status",
                "case_number"
              ],
              "additionalProperties": false
            }
          },
          "eligible_resolutions": {
            "type": "array",
            "description": "Resolutions the order or item is currently eligible for.",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "Eligible resolution type.",
                  "enum": [
                    "replacement",
                    "refund",
                    "locate_only"
                  ]
                },
                "preserves_original_price": {
                  "type": "boolean",
                  "description": "Whether the resolution keeps the eligible original price."
                },
                "return_required": {
                  "type": "boolean",
                  "description": "Whether the damaged or original item must be returned."
                },
                "photo_required": {
                  "type": "boolean",
                  "description": "Whether a photo is required before fulfillment."
                },
                "optional_photo_upload_available": {
                  "type": "boolean",
                  "description": "Whether an optional photo upload is offered."
                },
                "photo_upload_blocks_fulfillment": {
                  "type": "boolean",
                  "description": "Whether fulfillment waits on the photo upload."
                },
                "estimated_delivery": {
                  "type": "string",
                  "description": "Human-readable delivery estimate relative to the call (not ISO)."
                },
                "default_fulfillment": {
                  "type": "string",
                  "description": "Default fulfillment destination label, e.g. home_address_on_order."
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": false
            }
          },
          "notifications": {
            "type": "array",
            "description": "Notifications related to the order or its cases.",
            "items": {
              "type": "object",
              "properties": {
                "notification_id": {
                  "type": "string",
                  "description": "Notification identifier.",
                  "format": "uuid"
                },
                "type": {
                  "type": "string",
                  "description": "Notification message type.",
                  "enum": [
                    "replacement_confirmation",
                    "delivery_trace_confirmation",
                    "refund_trace_confirmation",
                    "case_reference"
                  ]
                },
                "status": {
                  "type": "string",
                  "description": "Notification delivery state.",
                  "enum": [
                    "queued",
                    "sent",
                    "delivered",
                    "failed"
                  ]
                },
                "subject_prefix": {
                  "type": "string",
                  "description": "Subject-line prefix of the sent message."
                },
                "optional_photo_link": {
                  "type": "boolean",
                  "description": "Whether the message contains an optional photo-upload link."
                },
                "photo_link_section": {
                  "type": "string",
                  "description": "Where the photo link appears in the message, e.g. later_in_email."
                }
              },
              "required": [
                "status"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "order_reference"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "get_product",
      "description": "Retrieve product variant, price, and inventory for replacement or fulfillment decisions.",
      "parameters": {
        "type": "object",
        "properties": {
          "product_reference": {
            "type": "string",
            "description": "Product or order-item identifier."
          },
          "location_id": {
            "type": "string",
            "description": "Optional store, pickup, or distribution location.",
            "format": "uuid"
          },
          "include_inventory": {
            "type": "boolean",
            "description": "Whether inventory is required."
          }
        },
        "required": [
          "product_reference",
          "include_inventory"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "product_reference": {
            "type": "string",
            "description": "Product reference."
          },
          "variant": {
            "type": "object",
            "description": "Variant details.",
            "properties": {
              "name": {
                "type": "string",
                "description": "Product name."
              },
              "color": {
                "type": "string",
                "description": "Variant color."
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "inventory": {
            "type": "object",
            "description": "Inventory availability; present when include_inventory was true.",
            "properties": {
              "in_stock": {
                "type": "boolean",
                "description": "Whether the product is in stock."
              },
              "same_variant_in_stock": {
                "type": "boolean",
                "description": "Whether the exact requested variant is in stock."
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "product_reference"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "open_delivery_trace",
      "description": "Open a missing-package or carrier investigation with the customer's requested resolution and timing constraints.",
      "parameters": {
        "type": "object",
        "properties": {
          "order_reference": {
            "type": "string",
            "description": "Order reference."
          },
          "item_references": {
            "type": "array",
            "description": "Affected order items.",
            "items": {
              "type": "string",
              "description": "Order-item reference."
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "description": "Trace reason.",
            "enum": [
              "delivered_not_received",
              "stalled_tracking",
              "wrong_location"
            ]
          },
          "requested_resolution": {
            "type": "string",
            "description": "Customer preference when already chosen.",
            "enum": [
              "replacement",
              "refund",
              "locate_only",
              "undecided"
            ]
          },
          "needed_by": {
            "type": "string",
            "description": "Optional customer timing requirement as an ISO calendar date.",
            "format": "date"
          }
        },
        "required": [
          "order_reference",
          "item_references",
          "reason"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "description": "Case identifier.",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "description": "Delivery-trace lifecycle state.",
            "enum": [
              "open",
              "awaiting_carrier_response",
              "eligibility_determined",
              "resolved",
              "closed"
            ]
          },
          "carrier_response_deadline": {
            "type": "string",
            "description": "Human-readable carrier deadline relative to the call (not ISO)."
          },
          "replacement_created": {
            "type": "boolean",
            "description": "Whether a replacement order exists."
          },
          "eligibility_triggers": {
            "type": "array",
            "description": "Events that would establish resolution eligibility.",
            "items": {
              "type": "string",
              "description": "Eligibility trigger, e.g. carrier_confirms_missing."
            }
          },
          "next_action": {
            "type": "string",
            "description": "Next supported action."
          },
          "approval_required": {
            "type": "boolean",
            "description": "Whether customer approval is required before resolution."
          },
          "approval_channel": {
            "type": "string",
            "description": "Channel through which approval is collected, e.g. trace_notification."
          },
          "notification_status": {
            "type": "string",
            "description": "Trace-notification delivery state at open time.",
            "enum": [
              "not_sent",
              "queued",
              "sent",
              "delivered",
              "failed"
            ]
          },
          "case_number": {
            "type": "string",
            "description": "Customer-facing support-case number; distinct from the internal case UUID."
          }
        },
        "required": [
          "case_id",
          "status",
          "replacement_created",
          "case_number"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "open_refund_trace",
      "description": "Open a payment investigation for a refund that lacks settlement confirmation; do not issue a duplicate refund while it is open.",
      "parameters": {
        "type": "object",
        "properties": {
          "order_reference": {
            "type": "string",
            "description": "Order reference."
          },
          "return_reference": {
            "type": "string",
            "description": "Return reference."
          },
          "payment_reference": {
            "type": "string",
            "description": "Original payment reference or masked card token."
          },
          "amount": {
            "type": "number",
            "description": "Amount under review.",
            "minimum": 0
          }
        },
        "required": [
          "order_reference",
          "return_reference",
          "payment_reference",
          "amount"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "description": "Case identifier.",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "description": "Refund-trace lifecycle state.",
            "enum": [
              "open",
              "reviewing_merchant_and_tender_records",
              "awaiting_external_settlement",
              "resolved",
              "closed"
            ]
          },
          "review_window_business_days": {
            "type": "array",
            "description": "[min,max] business days",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "duplicate_refund_blocked": {
            "type": "boolean",
            "description": "Whether duplicate refund is blocked."
          },
          "return_evidence_attached": {
            "type": "boolean",
            "description": "Whether return evidence was attached."
          },
          "case_number": {
            "type": "string",
            "description": "Customer-facing support-case number; distinct from the internal case UUID."
          }
        },
        "required": [
          "case_id",
          "status",
          "review_window_business_days",
          "duplicate_refund_blocked",
          "case_number"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "create_replacement_order",
      "description": "Create a replacement at the eligible original price and return the new order, delivery estimate, return disposition, and notification state.",
      "parameters": {
        "type": "object",
        "properties": {
          "order_reference": {
            "type": "string",
            "description": "Original order reference."
          },
          "item_references": {
            "type": "array",
            "description": "Items to replace.",
            "items": {
              "type": "string",
              "description": "Order-item reference."
            },
            "minItems": 1
          },
          "reason": {
            "type": "string",
            "description": "Replacement reason.",
            "enum": [
              "damaged",
              "defective",
              "missing",
              "wrong_item"
            ]
          },
          "fulfillment_method": {
            "type": "string",
            "description": "Requested fulfillment method.",
            "enum": [
              "ship_to_address",
              "store_pickup"
            ]
          },
          "fulfillment_location": {
            "type": "string",
            "description": "Address label or pickup location when known."
          },
          "customer_authorized": {
            "type": "boolean",
            "description": "Customer explicitly authorized creating this replacement order."
          }
        },
        "required": [
          "order_reference",
          "item_references",
          "reason",
          "fulfillment_method",
          "customer_authorized"
        ],
        "additionalProperties": false
      },
      "result_schema": {
        "type": "object",
        "properties": {
          "replacement_order_reference": {
            "type": "string",
            "description": "Replacement order reference."
          },
          "status": {
            "type": "string",
            "description": "Creation outcome.",
            "enum": [
              "created",
              "failed"
            ]
          },
          "balance_due": {
            "type": "number",
            "description": "Replacement balance due.",
            "minimum": 0
          },
          "currency": {
            "type": "string",
            "description": "Currency of monetary amounts in this result.",
            "enum": [
              "USD"
            ]
          },
          "fulfillment": {
            "type": "object",
            "description": "Fulfillment plan for the replacement.",
            "properties": {
              "method": {
                "type": "string",
                "description": "Fulfillment method.",
                "enum": [
                  "ship_to_address",
                  "store_pickup"
                ]
              },
              "location": {
                "type": "string",
