  ],
  "changes": [
   {"op": "update", "table": "notifications", "key": "96c3710a-750c-4f2c-8d7b-45926efebd92",
    "set": {"status": "sent", "sent_at": "$now"}}
  ]
 },
 {
  "event_id": "replacement-email-delivered",
  "at_seconds": 378,
  "actor": "mail_provider",
  "description": "The mail provider reports the replacement confirmation as delivered; the customer says at 380s that they can see it.",
  "when": [
   {"table": "notifications", "key": "96c3710a-750c-4f2c-8d7b-45926efebd92", "equals": {"status": "sent", "template": "replacement_confirmation"}}
  ],
  "changes": [
